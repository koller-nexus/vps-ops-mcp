# SSH connection (required: absolute path to a readable private key)
# VPS_HOST: SSH hostname. Use a placeholder, never a live production address in examples.
VPS_HOST=vps.example.invalid
VPS_USER=ubuntu
VPS_PORT=22
VPS_SSH_KEY_PATH=/absolute/path/to/your_private_key

# Opcional: se a chave tiver passphrase, use ssh-agent (recomendado).
# Não coloque a passphrase na linha de comando se puder evitar.
# VPS_SSH_KEY_PASSPHRASE=

# Diretório remoto do docker compose (absoluto no VPS)
# VPS_COMPOSE_DIR=/home/ubuntu/app

# Timeouts e limites
VPS_COMMAND_TIMEOUT_MS=30000
VPS_LOG_MAX_BYTES=200000

# false = apenas ferramentas readonly (rejeita mutações)
VPS_ALLOW_MUTATIONS=true